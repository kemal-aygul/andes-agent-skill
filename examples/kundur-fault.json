{
  "schema_version": "1.0",
  "study_name": "kundur-three-phase-fault",
  "description": "Apply and clear a three-phase fault on Bus 5 and export generator-speed and bus-voltage responses.",
  "defaults": {"log_level": 20, "strict": true, "overwrite": false, "copy_inputs": true, "seed": 42},
  "jobs": [
    {
      "id": "fault-bus-5",
      "case": {"builtin": "kundur/kundur_full.xlsx"},
      "routine": "tds",
      "disable_existing_events": ["Toggle"],
      "events": [
        {"type": "fault", "bus": 5, "tf": 1.0, "tc": 1.1, "rf": 0.0, "xf": 0.0001}
      ],
      "routine_config": {"tf": 5.0, "no_tqdm": 1},
      "outputs": {
        "timeseries": [
          {"model": "GENROU", "variable": "omega", "file": "generator-speeds.csv"},
          {"model": "Bus", "variable": "v", "file": "bus-voltages.csv"}
        ],
        "plots": [
          {
            "model": "GENROU",
            "variable": "omega",
            "ylabel": "Generator speed [pu]",
            "title": "Kundur response to Bus 5 fault",
            "grid": true,
            "legend": true,
            "dpi": 300,
            "file": "generator-speeds.png"
          }
        ]
      },
      "checks": {"require_convergence": true, "finite": true, "criteria": []}
    }
  ]
}
